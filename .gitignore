# --- secrets: Telegram token, chat id, API keys. Commit .env.example instead.
.env
.env.*
!.env.example

# --- runtime data: the database and its backups, cached filing PDFs (~7 GB),
# scan/backfill/dashboard logs. Keep only the manual fundamentals template,
# which the scanner reads for your own revenue overrides.
data/*
!data/manual_fundamentals.csv
*.db
*.db-wal
*.db-shm
*.log

# --- leftover working copies of modules (the real ones live in order_scanner/)
*.new.py

# --- Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
*.egg-info/
build/
dist/

# --- editors and OS
.vscode/
.idea/
.claude/settings.local.json
Thumbs.db
desktop.ini
.DS_Store
